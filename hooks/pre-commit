#!/usr/bin/env bash
# Pre-commit checks (fast: only inspects files staged for this commit):
#   1. no file above MAX_FILE_MB (default 50 MB)
#   2. YAML config + Markdown front-matter parse correctly

set -e

# ---------------------------------------------------------------------------
# 1. Block large files. GitHub rejects files > 100 MB and warns above 50 MB;
#    heavy media belong in media_originals/ (git-ignored) + the GitHub Release.
#    Override once with:  MAX_FILE_MB=80 git commit ...   (or --no-verify)
# ---------------------------------------------------------------------------
MAX_FILE_MB=${MAX_FILE_MB:-50}
LIMIT=$((MAX_FILE_MB * 1024 * 1024))
BIG=""
while IFS= read -r -d '' f; do
    size=$(git cat-file -s ":$f" 2>/dev/null || echo 0)
    if [ "$size" -gt "$LIMIT" ]; then
        BIG="$BIG\n  x $f ($((size / 1024 / 1024)) MB)"
    fi
done < <(git diff --cached --name-only --diff-filter=ACM -z)
if [ -n "$BIG" ]; then
    printf "pre-commit: staged files larger than %s MB:%b\n" "$MAX_FILE_MB" "$BIG" >&2
    echo "           Put originals in media_originals/ and run scripts/make_web_media.py," >&2
    echo "           then upload them with scripts/publish_media_release.sh." >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# 2. Validate YAML config + Markdown front-matter on staged files.
# ---------------------------------------------------------------------------
STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ya?ml|md)$' || true)
if [ -z "$STAGED" ]; then
    exit 0
fi

python3 - <<'PY'
import subprocess, sys, pathlib, re
try:
    import yaml
except ImportError:
    print("pre-commit: PyYAML not installed — skipping YAML validation.", file=sys.stderr)
    print("           install with: pip install pyyaml", file=sys.stderr)
    sys.exit(0)

def staged_files():
    out = subprocess.check_output(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
        text=True,
    ).splitlines()
    return [f for f in out if f.endswith((".yaml", ".yml", ".md"))]

FM_RE = re.compile(r"^---\s*\n(.*?)\n---\s*(\n|$)", re.DOTALL)

errors = []
for f in staged_files():
    p = pathlib.Path(f)
    if not p.exists():
        continue
    text = p.read_text(encoding="utf-8", errors="replace")
    try:
        if f.endswith((".yaml", ".yml")):
            yaml.safe_load(text)
        elif f.endswith(".md"):
            m = FM_RE.match(text)
            if m:
                yaml.safe_load(m.group(1))
    except yaml.YAMLError as e:
        errors.append(f"  x {f}\n    {e}")

if errors:
    print("pre-commit: YAML / front-matter errors", file=sys.stderr)
    print("\n".join(errors), file=sys.stderr)
    sys.exit(1)

print("pre-commit: YAML ok")
PY
